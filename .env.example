# Public URLs are committed in .env.development / .env.production.
# Only secrets go in .env.local (never commit it).

# Shared secret for POST /api/revalidate. Must match REVALIDATE_SECRET in Backend/.env.
REVALIDATE_SECRET=replace-with-a-long-random-string

# Overrides (normally set in .env.development / .env.production):
# NEXT_PUBLIC_SITE_URL=https://readyio.com
# NEXT_PUBLIC_BLOG_URL=https://blog.readyio.com
# NEXT_PUBLIC_API_URL=https://api.readyio.com        # newsletter signup
# NEXT_PUBLIC_CMS_API_URL=https://api.readyio.com/api # browser view counter
# CMS_API_URL=http://127.0.0.1:4000/api              # server-side article fetches
